# Aplicação
PORT=8000
NODE_ENV=development
APP_ORIGIN=http://localhost:8000
LOG_LEVEL=info
# Proteção adicional para a seed local. O serviço Compose de ferramentas a define internamente.
ELITEHUB_DEVELOPMENT_SEED=
ELITEHUB_DEVELOPMENT_RESET=

# Portas publicadas pelo Docker Compose. Evitam conflito com PostgreSQL e API locais.
API_HOST_PORT=8001
POSTGRES_HOST_PORT=5433

# PostgreSQL. Não use credenciais de produção neste arquivo.
DATABASE_URL=postgres://elitehub:substitua-por-senha-local@127.0.0.1:5432/elitehub_connect
SESSION_SECRET=substitua-por-ao-menos-32-caracteres-aleatorios

# Limitação de requisições. Redis é usado quando REDIS_URL estiver configurada.
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
REDIS_URL=redis://127.0.0.1:6379

# Worker transacional. O transporte atual usa a outbox no PostgreSQL; o contrato permite migrar para broker sem alterar os casos de uso.
OUTBOX_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=4

# Política comercial local. Configure antes de habilitar checkout.
SHIPPING_FIXED_CENTS=
MARKETPLACE_COMMISSION_BPS=

# Google OAuth. Em branco, o callback segue APP_ORIGIN; cadastre a URL efetiva no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# E-mail transacional fora do Compose. O Compose local usa Mailpit em http://localhost:8025
# por padrão; não configure um SMTP externo sem aprovação operacional.
SMTP_URL=
SMTP_FROM=
ELITEHUB_SMTP_URL=
ELITEHUB_SMTP_FROM=

# Pagamentos. Use somente credenciais sandbox e não habilite sem decisão financeira aprovada.
PAYMENT_PROVIDER=disabled
PAYMENT_SANDBOX=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Armazenamento S3 ou MinIO. O endpoint MinIO local usa caminho forçado automaticamente.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=sa-east-1
S3_BUCKET=elitehub-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Busca opcional compatível com OpenSearch ou Elasticsearch.
SEARCH_URL=
SEARCH_INDEX=elitehub-products

# Observabilidade
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
OTEL_SERVICE_NAME=elitehub-connect
OTEL_EXPORTER_OTLP_ENDPOINT=

# Proxy reverso. Em producao defina o numero exato de proxies confiaveis entre o cliente e a API.
TRUST_PROXY_HOPS=0

# Docker Compose local. Nunca reutilize estes valores em staging ou produção.
POSTGRES_USER=elitehub
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
