# Server
PORT=8000
NODE_ENV=development
APP_ORIGIN=http://localhost:8000

# PostgreSQL. A database is required for authentication and marketplace writes.
DATABASE_URL=postgres://elitehub:replace-with-local-password@127.0.0.1:5432/elitehub_connect

# Use a high-entropy value. Do not commit the real value.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth is deliberately disabled until these real values are supplied.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The route is fixed by this application. Configure this exact URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# SMTP remains disabled unless a real configured provider is available.
SMTP_URL=
SMTP_FROM=
